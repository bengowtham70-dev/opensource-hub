{
  "name": "opensource-hub",
  "version": "0.1.0",
  "description": "Find free open-source alternatives to paid software. Trust what you download. One command, local dashboard, zero accounts.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "opensource-hub": "bin/cli.js"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "bin",
    "src",
    "!src/server/payload.generated.js",
    "content",
    "dist/client",
    "README.md"
  ],
  "scripts": {
    "start": "node bin/cli.js",
    "dev:server": "node bin/cli.js --no-open",
    "dev": "vite",
    "build": "vite build",
    "test": "node --test --test-concurrency=1 --max-old-space-size=2048 \"test/**/*.test.js\"",
    "test:client": "vitest run",
    "fetch:screenshots": "node scripts/fetch-screenshots.mjs",
    "build:web": "node scripts/build-web-directory.mjs",
    "prepack": "node -e \"require('node:fs').rmSync('src/server/payload.generated.js',{force:true})\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "chalk": "^5.4.1",
    "commander": "^14.0.0",
    "express": "^5.1.0",
    "open": "^10.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.2.5",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@icons-pack/react-simple-icons": "^13.0.0",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.1.11",
    "@vitejs/plugin-react": "^5.0.0",
    "cmdk": "^1.1.1",
    "lucide-react": "^0.539.0",
    "motion": "^12.23.6",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.0",
    "simple-icons": "^15.0.0",
    "tailwindcss": "^4.1.11",
    "vite": "^7.1.0",
    "vitest": "^3.2.4",
    "zustand": "^5.0.7"
  }
}
