{
  "manifest_version": 3,
  "name": "OpenSource Hub — Free Alternatives Finder",
  "version": "1.0.0",
  "description": "Automatically alerts you to free, privacy-first open-source alternatives to paid SaaS products you visit.",
  "homepage_url": "https://bengowtham70-dev.github.io/opensource-hub",
  "author": "OpenSource Hub Community",
  "icons": {
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Find Open Source Alternatives"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "extension@opensource-hub.org",
      "strict_min_version": "109.0"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.notion.so/*",
        "*://*.figma.com/*",
        "*://*.slack.com/*",
        "*://*.airtable.com/*",
        "*://*.trello.com/*",
        "*://*.postman.com/*",
        "*://*.datadoghq.com/*",
        "*://*.sentry.io/*",
        "*://*.supabase.com/*",
        "*://*.firebase.google.com/*",
        "*://*.mailchimp.com/*",
        "*://*.hubspot.com/*",
        "*://*.canva.com/*",
        "*://*.zoom.us/*",
        "*://*.jira.atlassian.com/*",
        "*://*.atlassian.net/*",
        "*://*.asana.com/*",
        "*://*.clickup.com/*",
        "*://*.linear.app/*",
        "*://*.1password.com/*",
        "*://*.lastpass.com/*",
        "*://*.bitwarden.com/*",
        "*://*.zapier.com/*",
        "*://*.make.com/*",
        "*://*.segment.com/*",
        "*://*.mixpanel.com/*",
        "*://*.amplitude.com/*",
        "*://*.loom.com/*",
        "*://*.miro.com/*",
        "*://*.monday.com/*",
        "*://*.zendesk.com/*",
        "*://*.intercom.com/*",
        "*://*.pagerduty.com/*",
        "*://*.shopify.com/*",
        "*://*.mailgun.com/*",
        "*://*.salesforce.com/*",
        "*://*.tableau.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["storage"]
}
